# ScreenSolver 서버 프록시용 환경변수 예시 (§66)
#
# 이 파일은 "이름만" 알려 주는 예시입니다. 실제 키를 여기에 적지 마세요.
# 실제 값은 Netlify 사이트 설정 → Environment variables 에 넣습니다.
#   (로컬에서 netlify dev 로 시험할 때만 .env 로 복사해 쓰고, .env 는
#    .gitignore 에 들어 있어 커밋되지 않습니다.)
#
# 셋 다 넣을 필요는 없습니다. 넣은 것만 서버 프록시로 쓸 수 있고,
# 나머지는 사용자가 직접 키를 입력하는 기존 방식으로 동작합니다.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
